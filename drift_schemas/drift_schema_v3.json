        "name": "messages_search_insert",
        "sql": "CREATE TRIGGER messages_search_insert AFTER INSERT ON messages BEGIN\n  INSERT INTO message_search (rowid, body)\n    SELECT new.rowid, body FROM (\n      SELECT CAST(CASE json_type(new.json, '$.content')\n        WHEN 'text' THEN json_extract(new.json, '$.content')\n        WHEN 'object' THEN json_extract(new.json, '$.content.txt')\n      END AS TEXT) AS body\n    )\n    WHERE trim(coalesce(body, '')) <> ''\n      AND json_extract(new.json, '$.head.replace') IS NULL;\nEND;"
      }
    },
