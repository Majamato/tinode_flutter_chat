    {
      "name": "message_search",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE VIRTUAL TABLE IF NOT EXISTS \"message_search\" USING fts5(body, tokenize = 'unicode61 remove_diacritics 2');"
        }
      ]
    },
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"topic\" TEXT NOT NULL, \"seq\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, \"client_id\" TEXT NULL, PRIMARY KEY (\"topic\", \"seq\"));"
        }
      ]
    },
    {
      "name": "messages_search_insert",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER messages_search_insert AFTER INSERT ON messages BEGIN INSERT INTO message_search (\"rowid\", body) SELECT new.\"rowid\", body FROM (SELECT CAST(CASE json_type(new.json, '$.content') WHEN 'text' THEN json_extract(new.json, '$.content') WHEN 'object' THEN json_extract(new.json, '$.content.txt') END AS TEXT) AS body) WHERE trim(coalesce(body, '')) <> '' AND json_extract(new.json, '$.head.replace') IS NULL;END"
        }
      ]
    },
    {
      "name": "messages_search_update",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER messages_search_update AFTER UPDATE ON messages BEGIN DELETE FROM message_search WHERE \"rowid\" = old.\"rowid\";INSERT INTO message_search (\"rowid\", body) SELECT new.\"rowid\", body FROM (SELECT CAST(CASE json_type(new.json, '$.content') WHEN 'text' THEN json_extract(new.json, '$.content') WHEN 'object' THEN json_extract(new.json, '$.content.txt') END AS TEXT) AS body) WHERE trim(coalesce(body, '')) <> '' AND json_extract(new.json, '$.head.replace') IS NULL;END"
        }
      ]
    },
    {
      "name": "messages_search_delete",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER messages_search_delete AFTER DELETE ON messages BEGIN DELETE FROM message_search WHERE \"rowid\" = old.\"rowid\";END"
        }
      ]
    },
    {
      "name": "chats",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chats\" (\"topic\" TEXT NOT NULL, \"json\" TEXT NOT NULL, PRIMARY KEY (\"topic\"));"
        }
      ]
    },
    {
      "name": "members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"members\" (\"topic\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"json\" TEXT NOT NULL, PRIMARY KEY (\"topic\", \"user_id\"));"
        }
      ]
    },
    {
      "name": "topic_syncs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"topic_syncs\" (\"topic\" TEXT NOT NULL, \"covered\" TEXT NOT NULL DEFAULT '[]', \"synced_delete_id\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"topic\"));"
        }
      ]
    },
    {
      "name": "outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"topic\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"client_id\" TEXT NULL UNIQUE, \"payload\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"failure\" TEXT NULL, \"in_flight\" INTEGER NOT NULL DEFAULT 0 CHECK (\"in_flight\" IN (0, 1)), \"sent_after_seq\" INTEGER NOT NULL DEFAULT 0, \"attempts\" INTEGER NOT NULL DEFAULT 0);"
        }
